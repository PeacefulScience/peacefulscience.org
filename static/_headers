# Print HTML is Prince input only. Not a public page. (Lambda/Prince ignore this.)
/_prince/*
  X-Robots-Tag: noindex, nofollow, noarchive
/wp-content/plugins/onesignal-free-web-push-notifications/sdk_files/*.js.php
  Service-Worker-Allowed: /
  content-type: application/javascript; charset=utf-8
/font/*
  cache-control: public, max-age=7776000, s-max-age=7776000, immutable
  access-control-allow-origin: *
/os.xml
  content-type:  application/opensearchdescription+xml
/opensearch.xml
  content-type:  application/opensearchdescription+xml
